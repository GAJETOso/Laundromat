# ------------------------------------------------------------------
# Lustra — environment configuration
# Copy to .env.local for development. Every variable is optional for
# the demo build; features degrade gracefully when unset.
# ------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://lustra.example.com

# Database (Prisma → PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/lustra

# Auth
JWT_SECRET=change-me-64-random-chars
NEXTAUTH_SECRET=change-me-too

# Payments (Paystack & Flutterwave are the primary processors for Nigeria;
# Stripe/PayPal serve international cards)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-mirror-it-in-meta-console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=choose-any-string

# AI assistant (optional LLM upgrade for Lumi — see docs/BOTS.md)
ANTHROPIC_API_KEY=

# Maps & geocoding
NEXT_PUBLIC_MAPS_KEY=

# Media
CLOUDINARY_URL=

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=

# Cache / rate limiting
REDIS_URL=

# Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
