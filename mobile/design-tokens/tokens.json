{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Lustra Design Tokens",
    "version": "1.0.0",
    "description": "Single source of truth for the Lustra visual language across web, iOS, and Android. Mirrors tailwind.config.ts and src/app/globals.css — change here, regenerate platform files.",
    "platforms": ["web", "ios", "android", "react-native"]
  },
  "color": {
    "ink": {
      "50": "#f4f6fb",
      "100": "#e8ecf6",
      "200": "#ccd6ea",
      "300": "#9fb1d6",
      "400": "#6b87bd",
      "500": "#4867a5",
      "600": "#37508a",
      "700": "#2e4170",
      "800": "#29385e",
      "900": "#0b1220",
      "950": "#060a14"
    },
    "aqua": {
      "50": "#ecfeff",
      "100": "#cffafe",
      "200": "#a5f3fc",
      "300": "#67e8f9",
      "400": "#22d3ee",
      "500": "#06b6d4",
      "600": "#0891b2",
      "700": "#0e7490"
    },
    "semantic": {
      "light": {
        "background": "#f7f8fb",
        "foreground": "#0b1220",
        "card": "#ffffff",
        "muted": "#64748b",
        "border": "#e2e8f0",
        "accent": "#06b6d4"
      },
      "dark": {
        "background": "#060a14",
        "foreground": "#edf2fa",
        "card": "#0d1424",
        "muted": "#94a3b8",
        "border": "#1e293b",
        "accent": "#22d3ee"
      }
    },
    "status": {
      "success": "#10b981",
      "info": "#06b6d4",
      "warning": "#f59e0b",
      "processing": "#8b5cf6",
      "error": "#ef4444"
    },
    "gradient": {
      "cta": { "type": "linear", "angle": 135, "stops": ["#06b6d4", "#4867a5"] }
    }
  },
  "typography": {
    "fontFamily": {
      "ios": "SF Pro Display",
      "android": "Roboto / Google Sans (fallback: sans-serif-medium)",
      "reactNative": "System",
      "note": "Web uses the system stack; native apps should too — no font downloads."
    },
    "scale": {
      "caption": { "size": 12, "lineHeight": 16, "weight": "600" },
      "body-sm": { "size": 14, "lineHeight": 21, "weight": "400" },
      "body": { "size": 16, "lineHeight": 26, "weight": "400" },
      "title-sm": { "size": 18, "lineHeight": 26, "weight": "600" },
      "title": { "size": 20, "lineHeight": 28, "weight": "600" },
      "headline": { "size": 24, "lineHeight": 30, "weight": "700", "tracking": -0.02 },
      "display-sm": { "size": 30, "lineHeight": 36, "weight": "700", "tracking": -0.02 },
      "display": { "size": 36, "lineHeight": 40, "weight": "700", "tracking": -0.02 },
      "hero": { "size": 48, "lineHeight": 50, "weight": "700", "tracking": -0.03 }
    },
    "eyebrow": { "size": 12, "weight": "700", "tracking": 0.2, "transform": "uppercase" }
  },
  "spacing": {
    "unit": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
    "screenPadding": 20,
    "sectionGap": 96,
    "cardPadding": 28
  },
  "radius": {
    "control": 16,
    "input": 16,
    "card": 24,
    "sheet": 32,
    "hero": 40,
    "pill": 999
  },
  "elevation": {
    "card": { "y": 8, "blur": 24, "color": "#0b1220", "opacity": 0.12 },
    "lifted": { "y": 20, "blur": 60, "color": "#0b1220", "opacity": 0.25 },
    "glow": { "y": 0, "blur": 60, "color": "#22d3ee", "opacity": 0.35 }
  },
  "glass": {
    "light": { "background": "#ffffff", "opacity": 0.6, "blur": 24, "borderColor": "#ffffff", "borderOpacity": 0.2 },
    "dark": { "background": "#ffffff", "opacity": 0.06, "blur": 24, "borderColor": "#ffffff", "borderOpacity": 0.1 }
  },
  "motion": {
    "easing": { "standard": [0.21, 0.6, 0.35, 1], "note": "cubic-bezier; use for all entrances and layout changes" },
    "duration": { "micro": 150, "control": 250, "entrance": 700, "ambient": 7000 },
    "stagger": 80,
    "reducedMotion": "All animation must collapse to opacity-only (or none) when the OS accessibility setting requests reduced motion."
  },
  "iconography": { "set": "Lucide", "stroke": 1.8, "sizes": { "sm": 16, "md": 20, "lg": 24, "xl": 28 } },
  "components": {
    "buttonPrimary": {
      "height": 52,
      "radius": 999,
      "background": "gradient.cta",
      "textColor": "#ffffff",
      "textStyle": "title-sm",
      "shadow": "glow",
      "pressedScale": 0.97
    },
    "buttonSecondary": {
      "height": 52,
      "radius": 999,
      "background": "semantic.card",
      "border": "semantic.border",
      "textStyle": "title-sm"
    },
    "chip": { "height": 30, "radius": 999, "paddingX": 12, "textStyle": "caption" },
    "input": { "height": 48, "radius": 16, "background": "semantic.card", "border": "semantic.border", "focusBorder": "aqua.500" },
    "tabBar": {
      "style": "glass",
      "items": ["Home", "Stores", "Book (raised center button, cta gradient)", "Track", "Account"],
      "raisedButtonSize": 48
    },
    "statusColors": {
      "available": "status.success",
      "running": "status.info",
      "reserved": "status.warning",
      "finishing": "status.processing",
      "maintenance": "semantic.muted"
    }
  }
}
